{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "preview": "wrangler versions upload",
    "lint": "eslint .",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:push": "node scripts/run-drizzle.js push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/run-drizzle.js migrate",
    "db:studio": "node scripts/run-drizzle.js studio",
    "db:migrate:ci": "drizzle-kit migrate",
    "db:setup": "node scripts/setup-db.js"
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-presets": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.1",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "10.9.1",
    "jest": "30.5.1",
    "ts-jest": "29.4.12",
    "tsx": "^4.23.13",
    "wrangler": "^4.132.0"
  }
}
