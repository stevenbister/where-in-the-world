{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "where-in-the-world-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-21",
	"compatibility_flags": [
		"nodejs_als"
	],
	"workers_dev": true,
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "db",
			"database_name": "travel-log",
			"database_id": "4e3948b3-d370-4842-9cdd-1ca9089972f7"
		}
	],
