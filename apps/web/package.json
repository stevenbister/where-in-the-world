        "deploy": "pnpm run build && wrangler deploy",
        "cf-typegen": "wrangler types"
    },
    "dependencies": {
        "@repo/ui": "workspace:*",
        "@phosphor-icons/react": "^2.1.10",
        "react": "19.3.0",
