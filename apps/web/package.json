        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.60.1",
        "@repo/eslint-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.13.3",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "10.9.1",
        "globals": "^17.12.0",
        "vite": "^8.3.0",
        "wrangler": "^4.140.0"
    }
