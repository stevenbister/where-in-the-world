{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./base.json",
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ESNext", "DOM"],
        "noEmit": true,
        "allowArbitraryExtensions": true,
        "types": ["vite/client"],
        "jsx": "react-jsx"
    }
}
